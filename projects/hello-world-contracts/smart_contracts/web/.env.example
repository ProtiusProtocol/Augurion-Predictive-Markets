# Protius Web UI - Environment Variables
# 
# Copy this file to .env.local for local development, or set these on Vercel for production.
#
# Default values (if not set) will use LocalNet configuration for local development.

# ===== ALGORAND NETWORK CONFIGURATION =====

# Algod API server endpoint
# Local: http://127.0.0.1
# TestNet: https://testnet-api.algonode.cloud
# MainNet: https://mainnet-api.algonode.cloud
VITE_ALGOD_SERVER=http://127.0.0.1

# Algod API port
# Local: 4001
# TestNet/MainNet: 443 (or leave empty for public endpoints)
VITE_ALGOD_PORT=4001

# Algod API token
# Local: aaaa... (64 'a's)
# TestNet/MainNet: "" (empty for public endpoints)
VITE_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# ===== SMART CONTRACT APP IDS =====

# ProjectRegistry smart contract app ID
# Local: 1002
# TestNet: (deploy and set here)
VITE_PROJECT_REGISTRY_APP_ID=1002

# kW Token smart contract app ID
# Local: 1003
# TestNet: (deploy and set here)
VITE_KW_TOKEN_APP_ID=1003

# kWh Receipt smart contract app ID (optional)
# Local: 1004
# TestNet: (deploy and set here)
VITE_KWH_RECEIPT_APP_ID=1004

# Revenue Vault smart contract app ID (optional)
# Local: 1005
# TestNet: (deploy and set here)
VITE_REVENUE_VAULT_APP_ID=1005

# PPA Contract smart contract app ID (optional)
# Local: 1006
# TestNet: (deploy and set here)
VITE_PPA_CONTRACT_APP_ID=1006

# ===== EXAMPLES =====

# For LOCAL DEVELOPMENT (default):
# VITE_ALGOD_SERVER=http://127.0.0.1
# VITE_ALGOD_PORT=4001
# VITE_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# VITE_PROJECT_REGISTRY_APP_ID=1002
# VITE_KW_TOKEN_APP_ID=1003
# VITE_KWH_RECEIPT_APP_ID=1004
# VITE_REVENUE_VAULT_APP_ID=1005

# For TESTNET DEPLOYMENT (Vercel):
# VITE_ALGOD_SERVER=https://testnet-api.algonode.cloud
# VITE_ALGOD_PORT=
# VITE_ALGOD_TOKEN=
# VITE_PROJECT_REGISTRY_APP_ID=<your_testnet_registry_id>
# VITE_KW_TOKEN_APP_ID=<your_testnet_kwtoken_id>
# VITE_KWH_RECEIPT_APP_ID=<your_testnet_kwhreceipt_id>
# VITE_REVENUE_VAULT_APP_ID=<your_testnet_vault_id>
